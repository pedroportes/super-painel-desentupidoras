---
import cityData from '../data/cityConfig.json';

  const { 
    seo = cityData.seo, 
    cidade = cityData.cidade, 
    uf = cityData.uf, 
    empresaNome = cityData.empresaNome, 
    whatsapp = cityData.whatsapp,
    telefoneFixo = cityData.telefoneFixo,
    endereco = cityData.endereco,
    geoCoordinates = cityData.geoCoordinates,
    bairros = cityData.bairros,
    faqs = cityData.faqs
  } = Astro.props;

  const currentPath = Astro.url.pathname;
  
  // Real Production Canonical Base (Cloudflare / Vercel / Custom Domain)
  const cityKey = (cidade || cityData.cidade || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
  const hosting = cityData.hospedagem || 'cloudflare';
  const productionBaseUrl = cityData.deployUrl 
    ? cityData.deployUrl.replace(/\/$/, '')
    : (hosting === 'cloudflare' 
        ? `https://desentupidora-${cityKey}.pages.dev` 
        : (hosting === 'vercel' 
            ? `https://desentupidora-${cityKey}.vercel.app` 
            : `https://${cityData.dominio || `desentupidora${cityKey}.com.br`}`));

  const canonicalUrl = `${productionBaseUrl}${currentPath === '/' ? '' : currentPath}`;

  // O favicon pode vir em qualquer formato que o painel salvou
  // (.webp/.jpg/.png/.svg) — nunca fixar type="image/x-icon" igual antes,
  // que ficava errado sempre que o arquivo real não era .ico de verdade.
  const faviconHref = cityData.faviconUrl || '/favicon.svg';
  const faviconExt = faviconHref.split('.').pop()?.toLowerCase();
  const faviconMimeMap: Record<string, string> = {
    webp: 'image/webp',
    jpg: 'image/jpeg',
    jpeg: 'image/jpeg',
    png: 'image/png',
    svg: 'image/svg+xml',
    ico: 'image/x-icon'
  };
  const faviconType = faviconMimeMap[faviconExt || ''] || 'image/x-icon';

  // Use exact provided meta fields from the `seo` prop, otherwise fallback
  const finalMetaTitle = seo.metaTitle || `Desentupidora em ${cidade} ${uf} 24h | Atendimento Sem Quebrar Piso`;
  const finalMetaDescription = seo.metaDescription || `Especialistas em desentupimento de esgoto, pias, ralos e limpeza de fossa em ${cidade} ${uf}. Chegamos em 30 min. Orçamento gratuito 24h!`;
  
  // Schema JSON-LD LocalBusiness & EmergencyService
  const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "EmergencyService"],
  "name": `${empresaNome} - ${finalMetaTitle}`,
  "description": finalMetaDescription,
  "url": canonicalUrl,
  "telephone": `+55${whatsapp}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": endereco,
    "addressLocality": cidade,
    "addressRegion": uf,
    "addressCountry": "BR"
  },
  // STRICT RULE: nunca inventar/deixar coordenadas vazias no schema — um
  // valor "" é JSON-LD inválido. Só inclui 'geo' quando há valores reais.
  ...(geoCoordinates && geoCoordinates.latitude && geoCoordinates.longitude ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": parseFloat(geoCoordinates.latitude),
      "longitude": parseFloat(geoCoordinates.longitude)
    }
  } : {}),
  "areaServed": bairros.map(b => `${b}, ${cidade} - ${uf}`),
  "priceRange": "$$",
  "openingHours": "Mo-Su 00:00-23:59"
};

// Schema FAQPage for AEO
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<!DOCTYPE html>
<html lang="pt-BR" data-theme={cityData.paletaCores || 'urgencia-azul-laranja'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- STRICT SEO RULE: TITLE, META DESCRIPTION, CANONICAL & ROBOTS -->
    <title>{finalMetaTitle}</title>
    <meta name="description" content={finalMetaDescription} />
    <meta name="keywords" content={`desentupidora em ${cidade}, desentupimento ${cidade}, limpa fossa ${cidade}, desentupir pia ${cidade}`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type={faviconType} href={faviconHref} />

    <!-- OpenGraph / Social Meta Tags -->
    <meta property="og:title" content={finalMetaTitle} />
    <meta property="og:description" content={finalMetaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={empresaNome} />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalMetaTitle} />
    <meta name="twitter:description" content={finalMetaDescription} />
    
    <!-- Agent Discovery (AEO): sitemap real via Link header (public/_headers) + Markdown negotiation -->
    <link rel="alternate" type="text/markdown" href="/site-markdown" title="Versão em Markdown para Agentes de IA" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
  </head>
  <body>
    <slot />
    
    <!-- Elementor-like Live Inline Visual Editor Bridge for Super Painel -->
    <script>
      if (window.top !== window.self) {
        document.addEventListener('DOMContentLoaded', () => {
          initEditorBridge();
        });
        
        // Also run immediately if DOM is already ready
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
          initEditorBridge();
        }

        function initEditorBridge() {
          const editableSelector = 'h1, h2, h3, h4, h5, h6, p, span.section-badge, span.box-tag, span.badge-pill, .feature-tag, .bairro-chip span, .bairro-chip strong, .stat-card strong, .stat-card span, [data-editor-id], [data-edit-tab], #h1Title, #firstParagraph, #lastH2, #ctaButtonText, [id^="services."], [id^="faqs."], [id^="testimonials."], [id^="bairros."]';
          const editableElements = document.querySelectorAll(editableSelector);

          editableElements.forEach((el) => {
            el.setAttribute('contenteditable', 'true');
            el.setAttribute('spellcheck', 'false');

            el.addEventListener('focus', () => {
              const id = el.id || el.getAttribute('data-editor-id') || '';
              const tab = el.getAttribute('data-edit-tab') || 
                (['h1Title', 'firstParagraph', 'lastH2', 'ctaButtonText'].includes(id) ? 'hero' :
                 id.startsWith('services.') ? 'services' :
                 id.startsWith('faqs.') || id.startsWith('testimonials.') ? 'faqs' :
                 id.startsWith('bairros.') ? 'bairros' : 'hero');

              window.parent.postMessage({ type: 'SELECT_ELEMENT', elementId: id, tab: tab }, '*');
            });

            el.addEventListener('input', () => {
              const id = el.id || el.getAttribute('data-editor-id') || '';
              const content = (el as HTMLElement).innerText;
              window.parent.postMessage({ type: 'SYNC_CONTENT', elementId: id, content: content }, '*');
            });
          });

          // Prevent links from navigating away inside editor iframe
          document.body.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const link = target.closest('a');
            if (link) {
              e.preventDefault();
            }

            const editEl = target.closest(editableSelector) || target.closest('[data-edit-tab]');
            if (editEl) {
              const id = editEl.id || editEl.getAttribute('data-editor-id') || '';
              const tab = editEl.getAttribute('data-edit-tab') || 
                (['h1Title', 'firstParagraph', 'lastH2', 'ctaButtonText'].includes(id) ? 'hero' :
                 id.startsWith('services.') ? 'services' :
                 id.startsWith('faqs.') || id.startsWith('testimonials.') ? 'faqs' :
                 id.startsWith('bairros.') ? 'bairros' : 'hero');

              window.parent.postMessage({ type: 'SELECT_ELEMENT', elementId: id, tab: tab }, '*');
            }
          });

          // Receive real-time updates from parent sidebar without reloading page
          window.addEventListener('message', (event) => {
            if (event.data && event.data.type === 'UPDATE_ELEMENT') {
              const { elementId, newContent } = event.data;
              const el = document.getElementById(elementId) || document.querySelector(`[data-editor-id="${elementId}"]`);
              if (el && el !== document.activeElement && el.innerText !== newContent) {
                el.innerText = newContent;
              }
            }
          });

          // Dynamic styling for Elementor-like UI
          const style = document.createElement('style');
          style.innerHTML = `
            ${editableSelector}, [data-edit-tab] {
              cursor: text !important;
              transition: outline 0.15s ease, background-color 0.15s ease;
              border-radius: 4px;
            }
            ${editableSelector}:hover, [data-edit-tab]:hover {
              outline: 2px dashed #8b5cf6 !important;
              outline-offset: 4px;
              background-color: rgba(139, 92, 246, 0.08) !important;
            }
            ${editableSelector}:focus, [data-edit-tab]:focus {
              outline: 2px solid #8b5cf6 !important;
              outline-offset: 4px;
              background-color: rgba(139, 92, 246, 0.12) !important;
            }
          `;
          document.head.appendChild(style);
        }
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    font-family: 'Inter', sans-serif;
    scroll-behavior: smooth;
    background: var(--color-bg-dark, #0f172a);
    color: var(--color-text-main, #f8fafc);
  }
  body {
    overflow-x: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .text-center {
    text-align: center;
  }
  .btn {
    display: inline-block;
    cursor: pointer;
    text-align: center;
  }
</style>
