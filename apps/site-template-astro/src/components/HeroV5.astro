---
// HeroV5: composição editorial em duas colunas com painel operacional
// lateral. Diferente do V1/V4 porque o lado direito não é formulário nem
// foto simples: é um resumo de cobertura local com prova operacional.
const { seo, cidade, whatsapp, telefoneFixo, heroImage, bairros = [], services = [] } = Astro.props;

const localBairros = bairros.slice(0, 4);
const serviceHighlights = services.slice(0, 3);
---

<section class="hero-v5">
  <div class="container hero-v5-grid">
    <div class="hero-v5-content">
      <span class="hero-v5-kicker">Base local organizada em {cidade}</span>

      <!-- STRICT SEO RULE: H1 title -->
      <h1 id="h1Title" class="hero-v5-title" data-edit-tab="hero">{seo.h1Title}</h1>

      <!-- STRICT SEO RULE: Keyword in 1st Paragraph -->
      <p id="firstParagraph" class="hero-v5-paragraph" data-edit-tab="hero">
        {seo.firstParagraphText}
      </p>

      <ul class="hero-v5-proof-list" aria-label={`Diferenciais do atendimento em ${cidade}`}>
        <li>Chegada organizada por região, sem improviso</li>
        <li>Equipe técnica em rota para residências, comércio e condomínio</li>
        <li>Atendimento com explicação clara antes de executar</li>
      </ul>

      <div class="hero-v5-actions">
        {whatsapp && <a
          id="ctaButtonText"
          href={`https://wa.me/55${whatsapp}?text=Olá,%20preciso%20de%20atendimento%20em%20${cidade}`}
          class="btn btn-hero-v5-primary"
          target="_blank"
          rel="noopener"
          data-edit-tab="hero"
        >
          {seo.ctaButtonText || 'Solicitar atendimento agora'}
        </a>}
        {telefoneFixo && (
          <a href={`tel:${telefoneFixo.replace(/\D/g, '')}`} class="btn btn-hero-v5-secondary">
            {telefoneFixo}
          </a>
        )}
      </div>
    </div>

    <aside class="hero-v5-aside" aria-label={`Resumo de cobertura em ${cidade}`}>
      <div class="hero-v5-media">
        {heroImage ? (
          <img src={heroImage} alt={`Equipe de desentupimento em ${cidade}`} width="800" height="560" />
        ) : (
          <div class="hero-v5-media-placeholder"></div>
        )}
      </div>

      <div class="hero-v5-panel">
        <div class="hero-v5-stats">
          <div class="hero-v5-stat">
            <strong>30 min</strong>
            <span>Tempo médio</span>
          </div>
          <div class="hero-v5-stat">
            <strong>{localBairros.length || 4}+</strong>
            <span>Frentes locais</span>
          </div>
          <div class="hero-v5-stat">
            <strong>24h</strong>
            <span>Plantão contínuo</span>
          </div>
        </div>

        {localBairros.length > 0 && (
          <div class="hero-v5-neighborhoods">
            <span class="hero-v5-panel-label">Bairros de referência</span>
            <div class="hero-v5-chip-list">
              {localBairros.map((bairro: string) => (
                <span class="hero-v5-chip">{bairro}</span>
              ))}
            </div>
          </div>
        )}

        {serviceHighlights.length > 0 && (
          <div class="hero-v5-services">
            <span class="hero-v5-panel-label">Frentes mais buscadas</span>
            <ul>
              {serviceHighlights.map((service: any) => (
                <li>{service.icon || '•'} {service.title}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-v5 {
    padding: 76px 0 82px;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.06), transparent 32%),
      linear-gradient(180deg, var(--color-bg-dark, #0f172a) 0%, rgba(6, 16, 31, 0.96) 100%);
    color: var(--color-text-main, #ffffff);
  }
  .hero-v5-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: 34px;
    align-items: center;
  }
  .hero-v5-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--color-badge-bg, rgba(255, 255, 255, 0.08));
    color: var(--color-badge-text, #ffffff);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    margin-bottom: 18px;
  }
  .hero-v5-title {
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    line-height: 1.05;
    font-weight: 900;
    margin-bottom: 20px;
    max-width: 12ch;
  }
  .hero-v5-paragraph {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-text-muted, #cbd5e1);
    max-width: 62ch;
    margin-bottom: 24px;
  }
  .hero-v5-proof-list {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0 0 30px 0;
    list-style: none;
  }
  .hero-v5-proof-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.96rem;
    color: var(--color-text-main, #ffffff);
  }
  .hero-v5-proof-list li::before {
    content: "•";
    color: var(--color-accent, #f97316);
    font-weight: 900;
  }
  .hero-v5-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .btn-hero-v5-primary,
  .btn-hero-v5-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 24px;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }
  .btn-hero-v5-primary {
    background: var(--color-accent, #f97316);
    color: #ffffff;
    box-shadow: 0 18px 32px rgba(0, 0, 0, 0.28);
  }
  .btn-hero-v5-secondary {
    background: rgba(255, 255, 255, 0.02);
    color: var(--color-text-main, #ffffff);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
  }
  .hero-v5-aside {
    display: grid;
    gap: 18px;
  }
  .hero-v5-media {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    min-height: 260px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hero-v5-media img,
  .hero-v5-media-placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-v5-media img {
    object-fit: cover;
  }
  .hero-v5-media-placeholder {
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 45%),
      linear-gradient(180deg, var(--color-bg-card, #1e293b), rgba(8, 15, 29, 0.96));
  }
  .hero-v5-panel {
    padding: 24px;
    border-radius: 24px;
    background: rgba(8, 15, 29, 0.54);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }
  .hero-v5-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-v5-stat {
    padding: 14px 12px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    text-align: center;
  }
  .hero-v5-stat strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-text-main, #ffffff);
  }
  .hero-v5-stat span {
    font-size: 0.78rem;
    color: var(--color-text-muted, #cbd5e1);
  }
  .hero-v5-panel-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-badge-text, #ffffff);
    margin-bottom: 10px;
  }
  .hero-v5-neighborhoods {
    margin-bottom: 18px;
  }
  .hero-v5-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hero-v5-chip {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-main, #ffffff);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .hero-v5-services ul {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .hero-v5-services li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-main, #ffffff);
    font-size: 0.92rem;
  }
  @media (max-width: 900px) {
    .hero-v5-grid {
      grid-template-columns: 1fr;
    }
    .hero-v5-title {
      max-width: none;
    }
  }
  @media (max-width: 640px) {
    .hero-v5 {
      padding: 58px 0 64px;
    }
    .hero-v5-title {
      font-size: 2.15rem;
    }
    .hero-v5-actions {
      flex-direction: column;
    }
    .btn-hero-v5-primary,
    .btn-hero-v5-secondary {
      width: 100%;
    }
    .hero-v5-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
