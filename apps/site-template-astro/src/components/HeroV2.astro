---
const { seo, cidade, ddd, whatsapp, populacao } = Astro.props;
---

<section class="hero-v2">
  <div class="container hero-v2-container text-center">
    <div class="hero-v2-badge">
      <span>🚨 Plantão de Emergência 24h em {cidade} - Chegamos em 30 min</span>
    </div>

    <!-- STRICT SEO RULE: H1 title -->
    <h1 id="h1Title" class="hero-v2-title" data-edit-tab="hero">{seo.h1Title}</h1>

    <!-- STRICT SEO RULE: Keyword in 1st Paragraph -->
    <p id="firstParagraph" class="hero-v2-paragraph" data-edit-tab="hero">
      {seo.firstParagraphText}
    </p>

    <div class="hero-v2-cta-box">
      <a id="ctaButtonText" href={`https://wa.me/55${whatsapp}?text=Olá,%20preciso%20de%20desentupimento%20emergencial%20em%20${cidade}`} class="btn btn-hero-v2" target="_blank" rel="noopener" data-edit-tab="hero">
        {seo.ctaButtonText || `📲 Chamar no WhatsApp: (${ddd}) ${whatsapp.substring(2, 7)}-${whatsapp.substring(7)}`}
      </a>
      <p class="cta-sub">Visita técnica gratuita em {cidade} • Orçamento sem compromisso</p>
    </div>

    <div class="hero-v2-banner-stats">
      <div class="stat-card">
        <strong>100%</strong>
        <span>Garantia de Serviço</span>
      </div>
      <div class="stat-card">
        <strong>30 min</strong>
        <span>Tempo de Chegada</span>
      </div>
      <div class="stat-card">
        <strong>R$ 0</strong>
        <span>Taxa de Visita</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-v2 {
    padding: 80px 0 70px 0;
    background: linear-gradient(180deg, var(--color-bg-dark, #0f172a) 0%, var(--color-bg-card, #1e293b) 100%);
    color: var(--color-text-main, #ffffff);
    text-align: center;
  }
  .hero-v2-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .hero-v2-badge span {
    display: inline-block;
    background: var(--color-accent, #f97316);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 8px 18px;
    border-radius: 30px;
    margin-bottom: 20px;
  }
  .hero-v2-title {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 24px;
  }
  .hero-v2-paragraph {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-muted, #94a3b8);
    margin-bottom: 36px;
  }
  .hero-v2-cta-box {
    margin-bottom: 50px;
  }
  .btn-hero-v2 {
    background: var(--color-primary, #0284c7);
    color: #ffffff;
    padding: 18px 36px;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 900;
    text-decoration: none;
    display: inline-block;
    box-shadow: 0 12px 30px rgba(2, 132, 199, 0.4);
  }
  .cta-sub {
    font-size: 0.88rem;
    color: var(--color-text-muted, #cbd5e1);
    margin-top: 12px;
  }
  .hero-v2-banner-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 30px;
  }
  .stat-card strong {
    display: block;
    font-size: 1.8rem;
    color: var(--color-accent, #f97316);
    font-weight: 900;
  }
  .stat-card span {
    font-size: 0.85rem;
    color: var(--color-text-muted, #94a3b8);
  }
</style>
