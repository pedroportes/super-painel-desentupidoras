---
// ServicesGridV4: ícones circulares grandes numa faixa escura, estilo
// "passos"/vitrine técnica. Genuinamente diferente do card branco (V1),
// da lista com tag (V2) e da sanfona (V3).
import { slugify } from '../utils/slugify';
const { services, cidade, whatsapp } = Astro.props;
const cidadeSlug = slugify(cidade);
---

<section id="servicos" class="services-v4">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">FRENTE TÉCNICA COMPLETA</span>
      <h2>Estrutura Especializada em {cidade}</h2>
      <p>Equipamentos e equipes dedicadas para cada tipo de obstrução.</p>
    </div>

    <div class="services-steps">
      {services.map((s: any, idx: number) => (
        <div class="step-item">
          <div class="step-circle"><span>{String(idx + 1).padStart(2, '0')}</span></div>
          <h3 id={`services.${idx}.title`} data-edit-tab="services">{s.title}</h3>
          <p id={`services.${idx}.description`} data-edit-tab="services">{s.description}</p>
          <a href={`/${slugify(s.title)}-em-${cidadeSlug}`} class="step-link">
            Solicitar este serviço
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-v4 {
    padding: 80px 0;
    background: var(--color-bg-dark, #0f172a);
    color: #ffffff;
  }
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px auto;
  }
  .section-badge {
    color: var(--color-accent, #f97316);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }
  .section-header h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 10px 0 16px 0;
  }
  .section-header p {
    color: var(--color-text-muted, #94a3b8);
  }
  .services-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 34px;
  }
  .step-item {
    text-align: center;
  }
  .step-circle {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--color-bg-card, #1e293b);
    border: 2px solid var(--color-primary, #0284c7);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px auto;
  }
  .step-circle span {
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--color-primary, #0284c7);
  }
  .step-item h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .step-item p {
    color: var(--color-text-muted, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .step-link {
    color: var(--color-accent, #f97316);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
  }
</style>
