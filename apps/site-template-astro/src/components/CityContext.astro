---
const { cidade, uf, populacao, aboutCityTitle, aboutCityText, empresaNome } = Astro.props;

const defaultTitle = `Estrutura e Atendimento de Desentupidora em ${cidade} - ${uf}`;
const defaultText = `${cidade} é uma cidade dinâmica e em constante crescimento no estado de ${uf}, contando com uma população estimada em mais de ${populacao} habitantes. Para atender com máxima rapidez e eficiência residências, edifícios comerciais, indústrias e condomínios em todas as regiões do município, a ${empresaNome} mantém bases operacionais estratégicas e equipes móveis de plantão 24 horas, prontas para solucionar emergências hidráulicas sem danificar pisos ou paredes.`;

const title = aboutCityTitle || defaultTitle;
const text = aboutCityText || defaultText;
---

<section class="city-context-section">
  <div class="container">
    <div class="city-context-wrapper">
      <div class="city-context-header text-center">
        <span class="section-badge">📍 CONHEÇA A CIDADE & NOSSA ATUAÇÃO</span>
        <h2 id="aboutCityTitle" data-editor-id="aboutCityTitle" data-edit-tab="hero" class="city-title">
          {title}
        </h2>
        <p id="aboutCityText" data-editor-id="aboutCityText" data-edit-tab="hero" class="city-text">
          {text}
        </p>
      </div>

      <div class="city-stats-grid">
        <div class="city-stat-card">
          <div class="stat-icon">🏙️</div>
          <div class="stat-info">
            <strong>{populacao}</strong>
            <span>Habitantes em {cidade}</span>
          </div>
        </div>

        <div class="city-stat-card">
          <div class="stat-icon">⏱️</div>
          <div class="stat-info">
            <strong>20 a 35 min</strong>
            <span>Tempo Médio de Chegada</span>
          </div>
        </div>

        <div class="city-stat-card">
          <div class="stat-icon">🛡️</div>
          <div class="stat-info">
            <strong>100% Sem Quebra</strong>
            <span>Preservação de Pisos</span>
          </div>
        </div>

        <div class="city-stat-card">
          <div class="stat-icon">📋</div>
          <div class="stat-info">
            <strong>Até 90 Dias</strong>
            <span>Garantia por Escrito</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .city-context-section {
    padding: 60px 0;
    background: #0b1120;
    color: #f8fafc;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .city-context-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }
  .city-context-header {
    text-align: center;
    margin-bottom: 36px;
  }
  .section-badge {
    color: var(--color-primary, #38bdf8);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 1px;
    display: inline-block;
    margin-bottom: 10px;
  }
  .city-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: #ffffff;
    line-height: 1.3;
  }
  .city-text {
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 860px;
    margin: 0 auto;
  }
  .city-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .city-stat-card {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .city-stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.3);
  }
  .stat-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .stat-info strong {
    display: block;
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 800;
  }
  .stat-info span {
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 600;
  }
  @media (max-width: 768px) {
    .city-title { font-size: 1.5rem; }
    .city-text { font-size: 0.95rem; }
    .city-stats-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .city-stats-grid { grid-template-columns: 1fr; }
  }
</style>
