---
// HeroV6: bloco central com narrativa de processo, CTAs e trilha visual
// de atendimento. Diferente do V2 porque prioriza "como acontece" em vez
// de apenas headline + 3 stats.
const { seo, cidade, whatsapp, telefoneFixo, heroImage } = Astro.props;

const processSteps = [
  { number: '01', title: 'Triagem rápida', text: `Entendemos o cenário em ${cidade} e priorizamos a rota certa.` },
  { number: '02', title: 'Diagnóstico no local', text: 'Explicamos o problema antes de qualquer intervenção.' },
  { number: '03', title: 'Execução e garantia', text: 'Serviço concluído com retorno e orientação final.' }
];
---

<section class="hero-v6">
  <div class="hero-v6-backdrop" aria-hidden="true"></div>
  <div class="container hero-v6-container">
    <div class="hero-v6-shell">
      <span class="hero-v6-kicker">Atendimento planejado, claro e sem improviso</span>

      <!-- STRICT SEO RULE: H1 title -->
      <h1 id="h1Title" class="hero-v6-title" data-edit-tab="hero">{seo.h1Title}</h1>

      <!-- STRICT SEO RULE: Keyword in 1st Paragraph -->
      <p id="firstParagraph" class="hero-v6-paragraph" data-edit-tab="hero">
        {seo.firstParagraphText}
      </p>

      <div class="hero-v6-actions">
        <a
          id="ctaButtonText"
          href={`https://wa.me/55${whatsapp}?text=Olá,%20quero%20atendimento%20em%20${cidade}`}
          class="btn btn-hero-v6-primary"
          target="_blank"
          rel="noopener"
          data-edit-tab="hero"
        >
          {seo.ctaButtonText || 'Chamar equipe agora'}
        </a>
        {telefoneFixo && (
          <a href={`tel:${telefoneFixo.replace(/\D/g, '')}`} class="btn btn-hero-v6-secondary">
            Ligar: {telefoneFixo}
          </a>
        )}
      </div>

      <div class="hero-v6-process" role="list" aria-label={`Fluxo de atendimento em ${cidade}`}>
        {processSteps.map((step) => (
          <article class="hero-v6-step" role="listitem">
            <span class="hero-v6-step-number">{step.number}</span>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>

    {heroImage && (
      <div class="hero-v6-media" aria-hidden="true">
        <img src={heroImage} alt="" width="640" height="420" />
      </div>
    )}
  </div>
</section>

<style>
  .hero-v6 {
    position: relative;
    overflow: hidden;
    padding: 84px 0 92px;
    background:
      radial-gradient(circle at top center, rgba(255, 255, 255, 0.08), transparent 28%),
      linear-gradient(180deg, var(--color-bg-dark, #0f172a) 0%, rgba(6, 16, 31, 0.96) 100%);
    color: var(--color-text-main, #ffffff);
  }
  .hero-v6-backdrop {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.04), transparent 32%),
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.08), transparent 18%);
    pointer-events: none;
  }
  .hero-v6-container {
    position: relative;
  }
  .hero-v6-shell {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
    padding: 34px;
    border-radius: 30px;
    background: rgba(7, 13, 27, 0.56);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    backdrop-filter: blur(12px);
  }
  .hero-v6-kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--color-badge-bg, rgba(255, 255, 255, 0.08));
    color: var(--color-badge-text, #ffffff);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    margin-bottom: 18px;
  }
  .hero-v6-title {
    font-size: clamp(2.45rem, 4.8vw, 4.2rem);
    line-height: 1.04;
    font-weight: 900;
    margin-bottom: 20px;
  }
  .hero-v6-paragraph {
    max-width: 62ch;
    margin: 0 auto 28px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-text-muted, #cbd5e1);
  }
  .hero-v6-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 32px;
  }
  .btn-hero-v6-primary,
  .btn-hero-v6-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 26px;
    border-radius: 14px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 800;
  }
  .btn-hero-v6-primary {
    background: var(--color-primary, #0284c7);
    color: #ffffff;
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.24);
  }
  .btn-hero-v6-secondary {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--color-text-main, #ffffff);
  }
  .hero-v6-process {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .hero-v6-step {
    padding: 22px 20px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.04);
    text-align: left;
  }
  .hero-v6-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 34px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-badge-text, #ffffff);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }
  .hero-v6-step h2 {
    font-size: 1.08rem;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .hero-v6-step p {
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--color-text-muted, #cbd5e1);
    margin: 0;
  }
  .hero-v6-media {
    position: absolute;
    right: -60px;
    bottom: -80px;
    width: min(32vw, 420px);
    opacity: 0.16;
    pointer-events: none;
    filter: saturate(0.8);
  }
  .hero-v6-media img {
    width: 100%;
    height: auto;
    border-radius: 28px;
    display: block;
  }
  @media (max-width: 900px) {
    .hero-v6-process {
      grid-template-columns: 1fr;
    }
    .hero-v6-shell {
      padding: 28px 22px;
    }
    .hero-v6-media {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hero-v6 {
      padding: 62px 0 70px;
    }
    .hero-v6-title {
      font-size: 2.2rem;
    }
    .hero-v6-actions {
      flex-direction: column;
    }
    .btn-hero-v6-primary,
    .btn-hero-v6-secondary {
      width: 100%;
    }
    .hero-v6-step {
      text-align: center;
    }
  }
</style>
