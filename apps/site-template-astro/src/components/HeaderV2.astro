---
const { cidade, uf, ddd, whatsapp, empresaNome } = Astro.props;
---

<header class="header-v2 text-center">
  <div class="header-v2-banner">
    🚨 PLANTÃO DE EMERGÊNCIA 24H EM {cidade.toUpperCase()} - {uf} • ATENDIMENTO IMEDIATO
  </div>

  <div class="container header-v2-main">
    <div class="logo-centered">
      <span class="badge-v2">DESENTUPIDORA OFICIAL</span>
      <h1>{empresaNome}</h1>
      <p>Atendimento emergencial sem quebrar pisos em toda a cidade de {cidade}</p>
    </div>

    <div class="header-v2-cta">
      <a href={`https://wa.me/55${whatsapp}?text=Olá,%20preciso%20de%20atendimento%20emergencial%20em%20${cidade}`} class="btn btn-v2-whatsapp" target="_blank" rel="noopener">
        💬 WhatsApp 24h: ({ddd}) {whatsapp.substring(2, 7)}-{whatsapp.substring(7)}
      </a>
    </div>
  </div>
</header>

<style>
  .header-v2 { background: var(--color-bg-dark, #0f172a); color: #ffffff; border-bottom: 2px solid var(--color-primary, #0284c7); }
  .header-v2-banner { background: var(--color-accent, #f97316); color: #ffffff; font-weight: 800; font-size: 0.85rem; padding: 8px 0; letter-spacing: 0.5px; }
  .header-v2-main { padding: 24px 0; }
  .badge-v2 { display: inline-block; background: var(--color-badge-bg, rgba(2, 132, 199, 0.15)); color: var(--color-badge-text, #38bdf8); font-size: 0.75rem; font-weight: 800; padding: 4px 12px; border-radius: 20px; margin-bottom: 8px; }
  .logo-centered h1 { font-size: 1.8rem; font-weight: 900; color: #f8fafc; margin-bottom: 4px; }
  .logo-centered p { color: var(--color-text-muted, #94a3b8); font-size: 0.9rem; margin-bottom: 16px; }
  .btn-v2-whatsapp { background: #25d366; color: #ffffff; padding: 12px 24px; border-radius: 30px; font-weight: 800; text-decoration: none; display: inline-block; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3); }
</style>
