---
import { slugify } from '../utils/slugify';
import { partnerSlug } from '../utils/partnerSlug';
import cityData from '../data/cityConfig.json';

const { empresaNome, cidade, uf, ddd, whatsapp, cnpj, endereco, isDraft = false, isResearchMode = false, commercialClaimsVerified = true } = Astro.props;
const { services = cityData.services } = Astro.props;
const cidadeSlug = slugify(cidade);
const isPublicResearch = isDraft || isResearchMode || commercialClaimsVerified === false;
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-col">
      <h3 id="empresaNome" data-editor-id="empresaNome">{empresaNome}</h3>
      {isPublicResearch ? (
        <p>Referências locais e informações gerais sobre desentupimento em {cidade} - {uf}.</p>
      ) : (
        <>
          <p>Atendimento especializado em desentupimentos de esgotos, pias, vasos sanitários, ralos e limpeza de fossas em {cidade} - {uf}.</p>
          <p><small>CNPJ: <span id="cnpj" data-editor-id="cnpj">{cnpj}</span></small></p>
        </>
      )}
    </div>

    <div class="footer-col">
      {isPublicResearch ? (
        <>
          <h4>Pesquisa territorial</h4>
          <p>As páginas de bairro exibem fonte e fato local identificados.</p>
        </>
      ) : (
        <>
          <h4>Serviços em {cidade}</h4>
          <ul>
            {services.map((service: any) => (
              <li>
                <a href={`/${slugify(service.title)}-em-${cidadeSlug}/`}>{service.title}</a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>

    <div class="footer-col">
      {isPublicResearch ? (
        <>
          <h4>Informações de contato</h4>
          <p>{whatsapp ? 'Disponibilidade e condições são confirmadas diretamente pelo WhatsApp.' : 'Contato comercial ainda não foi publicado.'}</p>
          {whatsapp && <p>📲 WhatsApp: ({ddd}) {whatsapp.substring(2, 7)}-{whatsapp.substring(7)}</p>}
        </>
      ) : (
        <>
          <h4>Atendimento</h4>
          <p>📍 <span id="endereco" data-editor-id="endereco">{endereco}</span></p>
          {whatsapp && <p>📲 WhatsApp: ({ddd}) {whatsapp.substring(2, 7)}-{whatsapp.substring(7)}</p>}
        </>
      )}
    </div>

    {cityData.parceiros && cityData.parceiros.length > 0 && (
      <div class="footer-col">
        <h4>Rede de Parceiros</h4>
        <ul>
          {cityData.parceiros.map((p: any) => (
            <li>
              <a href={`/fora-da-area-de-cobertura/${partnerSlug(p)}/`}>
                {p.anchorText || `Desentupidora em ${p.cidade} ${p.uf}`}
              </a>
            </li>
          ))}
          <li>
            <a href="/fora-da-area-de-cobertura/" style="color: #38bdf8; font-weight: 700;">
              Ver todos os parceiros →
            </a>
          </li>
        </ul>
      </div>
    )}
  </div>

  <div class="footer-bottom">
    <div class="container text-center">
      <p>© {new Date().getFullYear()} {empresaNome} - {isPublicResearch ? `Referências locais de ${cidade} ${uf}.` : `Desentupidora em ${cidade} ${uf}.`}</p>
      <div class="footer-links">
        <a href="/politica-de-privacidade/">Política de Privacidade</a> |
        <a href="/termos-de-uso/">Termos de Uso</a> |
        <a href="/contato/">Contato</a>
        {cityData.parceiros && cityData.parceiros.length > 0 && (
          <> | <a href="/fora-da-area-de-cobertura/">Fora da Área de Cobertura</a></>
        )}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #090d16;
    color: #94a3b8;
    padding-top: 60px;
    font-size: 0.9rem;
  }
  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
    padding-bottom: 50px;
  }
  .footer-col h3 {
    color: #f8fafc;
    font-size: 1.3rem;
    margin-bottom: 15px;
    font-weight: 800;
  }
  .footer-col h4 {
    color: #f8fafc;
    font-size: 1.1rem;
    margin-bottom: 15px;
    font-weight: 700;
  }
  .footer-col p {
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-col ul li {
    margin-bottom: 10px;
  }
  .footer-col ul a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col ul a:hover {
    color: #38bdf8;
  }
  .footer-bottom {
    background: #04060a;
    padding: 24px 0;
    border-top: 1px solid #1e293b;
    font-size: 0.85rem;
  }
  .footer-links {
    margin-top: 8px;
  }
  .footer-links a {
    color: #64748b;
    text-decoration: none;
    margin: 0 4px;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: #cbd5e1;
  }
</style>
