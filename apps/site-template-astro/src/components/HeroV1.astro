---
const { seo, cidade, ddd, whatsapp, populacao } = Astro.props;
---

<section class="hero-v1">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>📍 Atendimento Garantido em {cidade} (Pop: {populacao})</span>
      </div>
      
      <!-- STRICT SEO RULE: H1 title -->
      <h1 id="h1Title" class="hero-title" data-edit-tab="hero">{seo.h1Title}</h1>
      
      <!-- STRICT SEO RULE: Keyword in 1st Paragraph -->
      <p id="firstParagraph" class="hero-paragraph" data-edit-tab="hero">
        {seo.firstParagraphText}
      </p>

      <div class="hero-features">
        <div class="feature-tag">✔ Visita Grátis & Orçamento sem compromisso</div>
        <div class="feature-tag">✔ Atendimento em até 30 minutos em {cidade}</div>
        <div class="feature-tag">✔ Equipamento moderno sem quebrar pisos</div>
        <div class="feature-tag">✔ Garantia de até 90 dias por escrito</div>
      </div>

      <div class="hero-actions">
        <a id="ctaButtonText" href={`https://wa.me/55${whatsapp}?text=Olá,%20preciso%20de%20atendimento%20emergencial%20em%20${cidade}`} class="btn btn-hero-primary" target="_blank" rel="noopener" data-edit-tab="hero">
          {seo.ctaButtonText || "🚀 Solicitar Visita Grátis no WhatsApp"}
        </a>
      </div>
    </div>

    <div class="hero-card">
      <div class="card-header">
        <h2>⚡ Urgência 24 Horas em {cidade}</h2>
        <p>Ligue ou envie mensagem e receba um técnico especialista na sua casa!</p>
      </div>

      <form class="hero-form" onsubmit="event.preventDefault(); window.open('https://wa.me/55' + whatsapp + '?text=Olá,%20preciso%20de%20orçamento%20para%20' + document.getElementById('servico-select').value + '%20em%20' + cidade, '_blank')">
        <div class="form-group">
          <label for="servico-select">Qual problema precisa resolver?</label>
          <select id="servico-select" class="form-control" required>
            <option value="Desentupimento de Esgoto">Esgoto Entupido</option>
            <option value="Desentupimento de Pia">Pia Entupida</option>
            <option value="Desentupimento de Vaso Sanitário">Vaso Sanitário Entupido</option>
            <option value="Desentupimento de Ralo">Ralo de Banheiro / Quintal</option>
            <option value="Limpeza de Fossa">Limpeza / Esgotamento de Fossa</option>
          </select>
        </div>

        <button type="submit" class="btn btn-form-submit">
          Chamar Técnico Agora
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .hero-v1 {
    padding: 60px 0 80px 0;
    background: var(--color-bg-dark, #0f172a);
    color: var(--color-text-main, #ffffff);
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }
  .hero-badge span {
    display: inline-block;
    background: var(--color-badge-bg, rgba(2, 132, 199, 0.15));
    color: var(--color-badge-text, #38bdf8);
    border: 1px solid var(--color-primary, #0284c7);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .hero-paragraph {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted, #94a3b8);
    margin-bottom: 24px;
  }
  .hero-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 32px;
  }
  .feature-tag {
    font-size: 0.9rem;
    color: var(--color-text-muted, #cbd5e1);
  }
  .btn-hero-primary {
    background: var(--color-accent, #f97316);
    color: #ffffff;
    padding: 16px 28px;
    border-radius: 10px;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(249, 115, 22, 0.3);
  }
  .hero-card {
    background: var(--color-bg-card, #1e293b);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 32px;
  }
  .card-header h2 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .card-header p {
    font-size: 0.9rem;
    color: var(--color-text-muted, #94a3b8);
    margin-bottom: 20px;
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-group label {
    display: block;
    font-size: 0.88rem;
    color: var(--color-text-muted, #cbd5e1);
    margin-bottom: 8px;
  }
  .form-control {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    background: var(--color-bg-dark, #0f172a);
    border: 1px solid #334155;
    color: #ffffff;
  }
  .btn-form-submit {
    width: 100%;
    background: var(--color-primary, #0284c7);
    color: #ffffff;
    padding: 14px;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-features {
      grid-template-columns: 1fr;
    }
    .hero-card {
      margin-top: 20px;
    }
  }
</style>
