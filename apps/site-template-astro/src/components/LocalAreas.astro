---
import { slugify } from '../utils/slugify';
const { cidade, uf, bairros, whatsapp, heroImage } = Astro.props;
---

<section id="bairros" class="local-areas-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-badge">COBERTURA GEOGRÁFICA</span>
      <h2>Atendimento Rápido nos Bairros de {cidade} - {uf}</h2>
      <p>Nossas frotas de suporte estão estrategicamente posicionadas para atender residências e empresas em toda a cidade de {cidade}:</p>
    </div>

    <div class="bairros-grid" data-edit-tab="bairros">
      {bairros.map((bairrosName: string, idx: number) => (
        <a href={`/${slugify(bairrosName)}`} class="bairro-chip">
          <span class="pin-icon">📍</span>
          <span>Desentupidora em <strong id={`bairros.${idx}`} data-editor-id={`bairros.${idx}`}>{bairrosName}</strong> ({cidade})</span>
        </a>
      ))}
    </div>

    <div class="bairros-note text-center">
      <p>Seu bairro não está na lista acima? **Atendemos 100% dos bairros e zonas rurais de {cidade}!**</p>
      <a href={`https://wa.me/55${whatsapp}?text=Olá,%20vocês%20atendem%20no%20meu%20bairro%20em%20${cidade}?`} class="btn btn-bairros" target="_blank" rel="noopener">
        📲 Confirmar Atendimento no Meu Bairro
      </a>
    </div>

    <!-- Map Section (+ foto local, quando cadastrada) -->
    <div class="map-container">
      <h3 class="text-center" style="margin-bottom: 20px; color: #0f172a; font-size: 1.5rem;">Nossa Sede e Área de Cobertura</h3>
      <div class:list={['map-photo-grid', { 'has-photo': !!heroImage }]}>
        {heroImage && (
          <div class="local-photo-wrapper">
            <img src={heroImage} alt={`${cidade} - ${uf}`} class="local-photo" width="1600" height="1000" loading="lazy" />
          </div>
        )}
        <div class="iframe-wrapper">
          <iframe
            title={`Mapa de cobertura em ${cidade} - ${uf}`}
            width="100%"
            height="400"
            frameborder="0"
            scrolling="no"
            marginheight="0"
            marginwidth="0"
            src={`https://maps.google.com/maps?q=${cidade},${uf}&t=&z=13&ie=UTF8&iwloc=&output=embed`}
            style="border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.05);"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .local-areas-section {
    padding: 80px 0;
    background: #ffffff;
    color: #0f172a;
  }
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px auto;
  }
  .section-badge {
    color: #0284c7;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }
  .section-header h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 10px 0 16px 0;
  }
  .bairros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }
  .bairro-chip {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 14px 18px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #334155;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }
  .bairro-chip:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    transform: translateY(-2px);
  }
  .bairros-note p {
    color: #64748b;
    font-size: 1rem;
    margin-bottom: 20px;
  }
  .btn-bairros {
    background: #0284c7;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
  }
  .map-container {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid #e2e8f0;
  }
  .iframe-wrapper {
    overflow: hidden;
    border-radius: 12px;
  }
  .map-photo-grid {
    display: block;
  }
  .map-photo-grid.has-photo {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 24px;
    align-items: stretch;
  }
  .local-photo-wrapper {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    aspect-ratio: 4 / 3;
  }
  .local-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 900px) {
    .map-photo-grid.has-photo {
      grid-template-columns: 1fr;
    }
    .local-photo-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>
