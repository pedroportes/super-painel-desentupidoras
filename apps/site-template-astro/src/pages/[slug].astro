---
import Layout from '../layouts/Layout.astro';
import cityData from '../data/cityConfig.json';
import { slugify } from '../utils/slugify';
import '../styles/themePalettes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import FAQ from '../components/FAQ.astro';
import Benefits from '../components/Benefits.astro';

export async function getStaticPaths() {
  const cidadeSlug = slugify(cityData.cidade);
  
  // Create a route for every service
  const servicePaths = cityData.services.map((service) => {
    const slug = `${slugify(service.title)}-em-${cidadeSlug}`;
    return {
      params: { slug },
      props: {
        type: 'service',
        title: service.title,
        description: service.description,
        icon: service.icon
      }
    };
  });

  // Create a route for every neighborhood
  const neighborhoodPaths = cityData.bairros.map((bairro) => {
    const slug = slugify(bairro);
    return {
      params: { slug },
      props: {
        type: 'neighborhood',
        name: bairro
      }
    };
  });

  return [...servicePaths, ...neighborhoodPaths];
}

const { slug } = Astro.params;
const props = Astro.props;

// Prepare custom SEO based on page type
let pageSeo = { ...cityData.seo };
let pageFaqs = [];
// Textos variados do corpo da página de bairro (ver bloco 'neighborhood'
// abaixo) — declarados aqui em escopo de módulo porque o template JSX
// usa essas variáveis fora do bloco `if` onde são atribuídas.
let heroDescription = '';
let quickAnswerText = '';
let card1Text = '';
let card2Text = '';
let card3Text = '';
let card4Text = '';
let landmark1Text = '';
let landmark2Text = '';
let landmark3Text = '';
let landmark4Text = '';

if (props.type === 'service') {
  const serviceName = props.title;
  // 🚫 Regra de ouro (achado 31/08/2026, São Caetano do Sul): o metaTitle
  // NÃO pode estourar 60 caracteres, mas o nome do serviço já vem prefixado
  // com "Desentupimento de"/"Desobstrução de" em vários registros de
  // cities.json — manter o prefixo completo E "Desentupidora de" na frente
  // duplicava o conceito e estourava o limite pra qualquer cidade de nome
  // composto (ex: "Desentupidora de Desentupimento de Vaso Sanitário em
  // Cachoeiro de Itapemirim ES" = 79 caracteres). Corrigido com 2 passos:
  // 1) tira o prefixo redundante do nome do serviço antes de recombinar;
  // 2) se ainda estourar 60 com o UF, tenta de novo sem o UF (degradação
  // graciosa, nunca corta o nome da cidade/bairro — isso seria dado errado,
  // não só estética).
  const shortServiceName = serviceName.replace(/^Desentupimento (de\s+)?/i, '').replace(/^Desobstru[cç][aã]o (de\s+)?/i, '');
  const titleWithUf = `Desentupidora de ${shortServiceName} em ${cityData.cidade} ${cityData.uf}`;
  const titleNoUf = `Desentupidora de ${shortServiceName} em ${cityData.cidade}`;
  let serviceTitle = titleWithUf.length <= 60 ? titleWithUf : titleNoUf;
  // Piso de 40 caracteres (regra de ouro 2): cidade curta ("Linhares") +
  // serviço curto ("Esgoto") gera título de só 38 chars sem isso — achado
  // real 31/08/2026 ao replicar o fix pras 13 cidades restantes. "24h" é
  // fato real (toda cidade opera plantão 24h), nunca dado inventado.
  if (serviceTitle.length < 40) serviceTitle += ' - Atendimento 24h';
  pageSeo.metaTitle = serviceTitle;
  // Mesma lógica de degradação graciosa do título: a versão "longa" cobre
  // o piso de 120 caracteres (regra de ouro 2) até pra serviços de nome
  // curto ("Pia" em cidade curta batia só 96 chars sem esse texto extra);
  // se o serviço/cidade for muito comprido e estourar o teto de 160, cai
  // pra uma versão mais enxuta em vez de cortar o nome do serviço/cidade.
  const descLong = `Desentupidora especialista em ${shortServiceName.toLowerCase()} em ${cityData.cidade} ${cityData.uf}. Atendimento rápido, visita técnica e orçamento gratuito. Plantão de emergência 24h!`;
  const descMedium = `Desentupidora especialista em ${shortServiceName.toLowerCase()} em ${cityData.cidade} ${cityData.uf}. Atendimento rápido e orçamento gratuito. Plantão 24h!`;
  pageSeo.metaDescription = descLong.length <= 160 ? descLong : descMedium;
  pageSeo.h1Title = titleWithUf;
  pageSeo.firstParagraph = `Problemas com entupimento? Nossa equipe é especializada em desentupidora de ${shortServiceName.toLowerCase()} em ${cityData.cidade} ${cityData.uf}. Oferecemos atendimento emergencial rápido, serviço 100% limpo sem quebrar azulejos, com garantia por escrito e orçamento gratuito na sua residência ou empresa.`;
  pageSeo.lastH2 = `Por que somos a melhor opção para desentupidora de ${shortServiceName.toLowerCase()} em ${cityData.cidade}?`;
  
  pageFaqs = [
    { question: `Vocês atendem emergência para ${serviceName.toLowerCase()} em ${cityData.cidade}?`, answer: `Sim! Nosso plantão é 24 horas. Chegamos na sua residência ou empresa em até 30 minutos em qualquer bairro de ${cityData.cidade}.` },
    { question: `Precisa quebrar a parede para resolver o problema de ${serviceName.toLowerCase()}?`, answer: "Na grande maioria das vezes não. Utilizamos equipamentos modernos rotativos e de hidrojateamento que desobstruem o encanamento por dentro, sem necessidade de quebra-quebra." },
    { question: `A visita técnica para ${serviceName.toLowerCase()} é cobrada?`, answer: `Não cobramos taxa de visita em ${cityData.cidade}. Nossos técnicos vão até o local, avaliam a situação e passam um orçamento transparente sem compromisso.` },
    { question: `Qual é a garantia do serviço de ${serviceName.toLowerCase()}?`, answer: `Oferecemos garantia por escrito de até 90 dias para todos os nossos serviços de desentupimento, garantindo sua total tranquilidade.` },
    { question: `Vocês atendem empresas e comércios para ${serviceName.toLowerCase()}?`, answer: `Sim, possuímos equipes especializadas tanto para atendimento residencial quanto para condomínios, restaurantes, indústrias e comércios em geral.` },
    { question: `Quais equipamentos são usados no ${serviceName.toLowerCase()}?`, answer: `Utilizamos maquinário de ponta, como molas rotativas K-50 e K-500, além de caminhões de hidrojateamento de alta pressão, dependendo da gravidade da obstrução.` }
  ];
} else if (props.type === 'neighborhood') {
  const bairroName = props.name;
  // 🚫 Regra de ouro 1 (conteúdo quase-duplicado): até esta correção,
  // TODO o corpo de texto de toda página de bairro era 100% fixo — só o
  // nome do bairro variava, o resto (frases dos 4 cards "Conhecendo o
  // Bairro", da seção "Resposta Rápida" e das 4 caixas de "Referências")
  // era idêntico palavra por palavra em qualquer bairro de qualquer
  // cidade. Numa cidade com 15-30 bairros isso é 15-30 páginas
  // quase-clones publicadas — mesmo risco de "scaled content abuse" da
  // regra 1, só que dentro da própria cidade em vez de entre cidades.
  //
  // Não temos dado de pesquisa real por bairro em escala (300+ bairros
  // cadastrados hoje) pra escrever texto 100% único e factual — inventar
  // characterísticas específicas de um bairro que não conferimos violaria
  // a regra de nunca inventar dado. Solução aplicada: cada bloco de texto
  // abaixo tem 4-5 variações escritas à mão (ângulos/redação diferentes,
  // mas nenhuma alega um fato específico não verificado daquele bairro
  // exato) e a variação é escolhida de forma determinística por hash do
  // nome do bairro + id da cidade — o mesmo bairro sempre cai na mesma
  // variação (estável entre builds), e bairros diferentes tendem a cair
  // em variações diferentes, inclusive entre cidades (evita, por exemplo,
  // todo bairro chamado "Centro" no Brasil inteiro ter texto idêntico).
  function pickText<T>(arr: T[], seed: string): T {
    let h = 0;
    for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
    return arr[h % arr.length];
  }
  const seedBase = `${cityData.id || cityData.cidade}-${bairroName}`;

  const heroDescVariations = [
    `Precisando de uma desentupidora no <strong>${bairroName}</strong>, em <strong>${cityData.cidade}</strong>? A <strong>${cityData.empresaNome}</strong> atende o bairro com técnicos que conhecem a região, visita técnica gratuita e orçamento fechado antes de começar qualquer serviço.`,
    `Entupimento não escolhe hora. No <strong>${bairroName}</strong>, em <strong>${cityData.cidade}</strong>, a <strong>${cityData.empresaNome}</strong> chega rápido, avalia o problema com visita técnica gratuita e só cobra depois de fechar o orçamento com você.`,
    `Se você mora ou trabalha no <strong>${bairroName}</strong>, <strong>${cityData.cidade}</strong>, conte com a <strong>${cityData.empresaNome}</strong>: diagnóstico no local sem custo, orçamento fechado antes de qualquer intervenção e equipe que já conhece as ruas do bairro.`,
    `A <strong>${cityData.empresaNome}</strong> atende o <strong>${bairroName}</strong>, em <strong>${cityData.cidade}</strong>, com visita técnica 100% gratuita — nossos técnicos avaliam o encanamento no local e só iniciam o serviço depois do orçamento aprovado por você.`,
  ];
  heroDescription = pickText(heroDescVariations, `${seedBase}-hero`);

  const quickAnswerVariations = [
    `A <strong>${cityData.empresaNome}</strong> mantém viaturas móveis e técnicos especializados posicionados estrategicamente na região do <strong>${bairroName}</strong>, em ${cityData.cidade} - ${cityData.uf}. Atendemos residências, condomínios prediais e empresas com desentupimento de esgoto, pia de cozinha, vasos sanitários, ralos pluviais, caixas de gordura, esgotamento de fossas sépticas e hidrojateamento de alta pressão. Assim que você entra em contato, agendamos uma <strong>visita técnica 100% gratuita</strong> para avaliar a tubulação no local e fechar o orçamento antes de iniciar o trabalho.`,
    `No <strong>${bairroName}</strong>, em ${cityData.cidade} - ${cityData.uf}, a <strong>${cityData.empresaNome}</strong> resolve entupimento de esgoto, pia, vaso sanitário, ralo, caixa de gordura e fossa séptica — residencial, condomínio ou empresa. Ligue ou chame no WhatsApp e agendamos uma <strong>visita técnica gratuita</strong> ainda hoje, com orçamento fechado antes de qualquer serviço começar.`,
    `Moradores e comércios do <strong>${bairroName}</strong> (${cityData.cidade} - ${cityData.uf}) contam com a <strong>${cityData.empresaNome}</strong> pra desentupimento de esgoto, pia, vaso, ralo, limpeza de caixa de gordura e fossa, além de hidrojateamento de alta pressão pra obstruções mais sérias. A <strong>visita técnica é sempre gratuita</strong>, e o orçamento é fechado antes de qualquer intervenção.`,
    `Atendemos o <strong>${bairroName}</strong> inteiro, em ${cityData.cidade} - ${cityData.uf}: esgoto, pia de cozinha, vaso sanitário, ralo pluvial, caixa de gordura, fossa séptica e hidrojateamento de alta pressão. A <strong>${cityData.empresaNome}</strong> faz uma <strong>visita técnica gratuita</strong> antes de fechar qualquer orçamento, pra você saber exatamente o que está pagando.`,
  ];
  quickAnswerText = pickText(quickAnswerVariations, `${seedBase}-quick`);

  const card1Variations = [
    `O bairro <strong>${bairroName}</strong> é uma localidade de destaque em ${cityData.cidade}, reunindo áreas residenciais ativas, condomínios, comércio variado, padarias, escolas e restaurantes com grande fluxo diário de pessoas.`,
    `<strong>${bairroName}</strong> concentra uma mistura de casas, condomínios e pequenos comércios em ${cityData.cidade} — perfil comum de bairro consolidado, com movimento constante de moradores e clientes ao longo do dia.`,
    `Como boa parte dos bairros de ${cityData.cidade}, o <strong>${bairroName}</strong> combina uso residencial e comercial: famílias, condomínios e estabelecimentos locais dividem a mesma rede de esgoto e água.`,
  ];
  card1Text = pickText(card1Variations, `${seedBase}-card1`);

  const card2Variations = [
    `Nossas viaturas de suporte circulam diariamente pelas principais vias de acesso do <strong>${bairroName}</strong>. Essa proximidade nos permite chegar em <strong>20 a 35 minutos</strong> para conter transbordamentos e entupimentos urgentes.`,
    `Mantemos equipes de plantão que já conhecem as ruas de acesso do <strong>${bairroName}</strong>, o que reduz o tempo de chegada em emergências — normalmente entre <strong>20 e 35 minutos</strong> desde o seu chamado.`,
    `Base descentralizada perto do <strong>${bairroName}</strong> significa resposta rápida: nossas equipes chegam em geral entre <strong>20 e 35 minutos</strong> pra conter vazamento, transbordamento ou entupimento urgente.`,
  ];
  card2Text = pickText(card2Variations, `${seedBase}-card2`);

  const card3Variations = [
    `A mescla de imóveis tradicionais e novas construções no ${bairroName} gera demandas constantes de desobstrução por gordura acumulada, raízes em tubulações coletoras e sobrecarga em encanamentos prediais.`,
    `Como em qualquer bairro com imóveis de idades diferentes, no ${bairroName} os problemas mais comuns são acúmulo de gordura na tubulação, raízes de árvore infiltradas e redes prediais sobrecarregadas em dias de chuva forte.`,
    `No ${bairroName}, os chamados mais frequentes envolvem entupimento por gordura em cozinhas, raízes que invadem a rede coletora e picos de uso que sobrecarregam encanamentos mais antigos.`,
  ];
  card3Text = pickText(card3Variations, `${seedBase}-card3`);

  const card4Variations = [
    `Trabalhamos com máquinas rotativas flexíveis K-50/K-500 e hidrojato de alta pressão, desobstruindo os canos por dentro e preservando seus pisos, azulejos e paredes intactos.`,
    `Usamos sondas rotativas K-50/K-500 e hidrojateamento de alta pressão pra limpar a tubulação por dentro — sem quebrar piso, azulejo ou parede pra chegar até o problema.`,
    `Nosso equipamento (molas rotativas K-50/K-500 e hidrojato de alta pressão) desobstrui o encanamento por dentro do próprio cano, então seu piso e revestimento saem intactos do atendimento.`,
  ];
  card4Text = pickText(card4Variations, `${seedBase}-card4`);

  const landmark1Variations = [
    `Cobertura nas vias de tráfego central e ruas residenciais do ${bairroName}.`,
    `Atendemos tanto as vias principais quanto as ruas mais internas do ${bairroName}.`,
    `Nossa equipe cobre igualmente as avenidas de maior movimento e as ruas residenciais do ${bairroName}.`,
  ];
  landmark1Text = pickText(landmark1Variations, `${seedBase}-lm1`);
  const landmark2Variations = [
    `Atendimento prioritário para síndicos e manutenção preventiva de colunas prediais.`,
    `Contrato de manutenção preventiva pra colunas prediais e atendimento direto ao síndico.`,
    `Suporte a condomínios com manutenção preventiva de coluna predial e prioridade em emergências.`,
  ];
  landmark2Text = pickText(landmark2Variations, `${seedBase}-lm2`);
  const landmark3Variations = [
    `Desobstrução higiênica e rápida para cozinhas comerciais sem interromper suas vendas.`,
    `Limpeza de caixa de gordura e desobstrução de cozinha comercial fora do horário de pico, sem parar suas vendas.`,
    `Atendimento rápido pra restaurantes e comércios, minimizando o tempo parado da cozinha.`,
  ];
  landmark3Text = pickText(landmark3Variations, `${seedBase}-lm3`);
  const landmark4Variations = [
    `Equipes uniformizadas e educadas com foco total na limpeza e preservação do imóvel.`,
    `Técnicos uniformizados, atendimento educado e cuidado extra pra não sujar ou danificar o imóvel.`,
    `Time uniformizado que trabalha com proteção de piso e limpeza do local ao final do serviço.`,
  ];
  landmark4Text = pickText(landmark4Variations, `${seedBase}-lm4`);
  // 🚫 Regra de ouro (achado 31/08/2026, São Caetano do Sul): mesmo
  // problema do bloco de serviço acima — bairro com nome composto
  // (ex: "Jardim Santa Rita de Cássia") + cidade composta estourava 60
  // caracteres fácil com o sufixo "| Atendimento 24h" (que não agrega
  // nada ao SEO, só ocupa espaço). Removido o sufixo fixo; se mesmo assim
  // passar de 60 com o UF, tenta de novo sem UF antes de aceitar o
  // resultado — nunca corta o nome do bairro/cidade em si.
  const titleWithUf = `Desentupidora em ${bairroName} - ${cityData.cidade} ${cityData.uf}`;
  const titleNoUf = `Desentupidora em ${bairroName} - ${cityData.cidade}`;
  let neighTitle = titleWithUf.length <= 60 ? titleWithUf : titleNoUf;
  // Piso de 40 caracteres (regra de ouro 2) — mesmo achado do bloco de
  // serviço acima, bairro curto + cidade curta (ex: "Araçá - Linhares ES")
  // ficava com só 36 chars.
  if (neighTitle.length < 40) neighTitle += ' - Atendimento 24h';
  pageSeo.metaTitle = neighTitle;
  // Mesma degradação graciosa do título: versão longa cobre o piso de 120
  // (bairro/cidade curtos, ex: "BNH, Linhares" ficava só 96 chars sem esse
  // texto extra); se bairro+cidade compostos estourarem o teto de 160, cai
  // pra uma versão mais enxuta — nunca corta o nome do bairro/cidade.
  const descLong = `Desentupidora no bairro ${bairroName}, ${cityData.cidade} ${cityData.uf}. Atendimento emergencial 24h, visita técnica e orçamento 100% grátis, sem compromisso!`;
  const descMedium = `Desentupidora no bairro ${bairroName}, ${cityData.cidade} ${cityData.uf}. Atendimento 24h, visita e orçamento grátis!`;
  pageSeo.metaDescription = descLong.length <= 160 ? descLong : descMedium;
  pageSeo.h1Title = `Desentupidora no ${bairroName}, ${cityData.cidade}: Atendimento Rápido no Seu Bairro`;
  pageSeo.firstParagraph = `Precisando de uma desentupidora no ${bairroName}, ${cityData.cidade}? A ${cityData.empresaNome} atende o bairro com técnicos que conhecem a região, visita técnica gratuita e orçamento fechado antes de começar qualquer serviço.`;
  pageSeo.lastH2 = `Por que escolher a ${cityData.empresaNome} no bairro ${bairroName}?`;
  
  // Reuse home FAQs but contextualize them to the neighborhood
  pageFaqs = (cityData.faqs || []).map(f => {
    return {
      question: f.question.replace(cityData.cidade, `${bairroName} - ${cityData.cidade}`),
      answer: f.answer.replace(cityData.cidade, `${bairroName} - ${cityData.cidade}`)
    };
  });
  while(pageFaqs.length < 6) {
    pageFaqs.push({
      question: `Como solicitar visita técnica no bairro ${bairroName}?`,
      answer: `Basta nos chamar no WhatsApp ou ligar. Uma equipe mais próxima ao bairro ${bairroName} será despachada imediatamente.`
    });
  }
}
---

<Layout {...cityData} seo={pageSeo} faqs={pageFaqs}>
  <Header {...cityData} />
  
  {props.type === 'neighborhood' ? (
    <!-- ========================================================================= -->
    <!-- MODELO MODERNO EM SEÇÕES CLARAS & CARDS (PADRÃO CRISTO REI / RONDONÓPOLIS) -->
    <!-- ========================================================================= -->
    <main class="bairro-page-wrapper">
      
      <!-- HERO DO BAIRRO (AZUL ESCURO PREMIUM) -->
      <section class="bairro-hero-sec">
        <div class="container text-center">
          <nav class="bairro-breadcrumbs">
            <a href="/">Início</a> <span>›</span> <a href="/#bairros">Bairros</a> <span>›</span> <span>{props.name}</span>
          </nav>
          
          <div class="badge-pill">
            <span>📍 Atendimento no Bairro {props.name}</span>
          </div>
          
          <h1 class="hero-title">
            Desentupidora no {props.name}, {cityData.cidade}: <br/>
            <span class="hero-highlight">Atendimento Rápido no Seu Bairro</span>
          </h1>
          
          <p class="hero-description" set:html={heroDescription} />

          <div class="hours-badge">
            🕒 Horário de Atendimento: Segunda a Domingo | Plantão Emergencial 24 Horas
          </div>

          <div class="hero-buttons-group">
            <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá,%20preciso%20de%20orçamento%20urgente%20no%20bairro%20${props.name}%20em%20${cityData.cidade}`} class="btn btn-wa-glow" target="_blank" rel="noopener">
              💬 Solicitar Orçamento Grátis no WhatsApp
            </a>
            <a href={`tel:${cityData.whatsapp}`} class="btn btn-phone-dark">
              📞 Ligar Agora: ({cityData.ddd}) {cityData.whatsapp.substring(2, 7)}-{cityData.whatsapp.substring(7)}
            </a>
          </div>

          <div class="hero-trust-bar">
            <div class="trust-pill"><span>✓</span> Orçamento Grátis</div>
            <div class="trust-pill"><span>✓</span> Garantia por Escrito*</div>
            <div class="trust-pill"><span>✓</span> Base no Próprio Bairro</div>
            <div class="trust-pill"><span>✓</span> Sem Quebrar Pisos</div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 1: RESPOSTA RÁPIDA (FUNDO BRANCO) -->
      <section class="section-block bg-white">
        <div class="container container-narrow">
          <div class="section-tag-center">
            <span class="tag-badge">RESPOSTA RÁPIDA</span>
          </div>
          <h2 class="section-heading text-center">Desentupidora no {props.name}: o que você precisa saber</h2>
          
          <div class="quick-answer-card">
            <div class="quick-answer-header">
              <span class="quick-icon">⚡</span>
              <h3>Atendimento Direto & Imediato no Bairro {props.name}</h3>
            </div>
            <p set:html={quickAnswerText} />
          </div>
        </div>
      </section>

      <!-- SEÇÃO 2: CONHECENDO O BAIRRO (FUNDO CINZA SUAVE) COM 4 CARDS ESTRUTURADOS -->
      <section class="section-block bg-light">
        <div class="container container-medium">
          <div class="section-tag-center">
            <span class="tag-badge">CONHECENDO O BAIRRO</span>
          </div>
          <h2 class="section-heading text-center">O Bairro {props.name} em {cityData.cidade}</h2>
          <p class="section-lead text-center">
            Entenda como nossa estrutura operacional e conhecimento da região garantem o atendimento mais rápido e eficiente:
          </p>

          <div class="about-bairro-grid">
            <!-- Card 1 -->
            <div class="about-card">
              <div class="about-card-icon">🏙️</div>
              <h3>Perfil e Infraestrutura</h3>
              <p set:html={card1Text} />
            </div>

            <!-- Card 2 -->
            <div class="about-card">
              <div class="about-card-icon">🚀</div>
              <h3>Agilidade e Chegada em 30 Min</h3>
              <p set:html={card2Text} />
            </div>

            <!-- Card 3 -->
            <div class="about-card">
              <div class="about-card-icon">⚠️</div>
              <h3>Desafios Hidráulicos Comuns</h3>
              <p set:html={card3Text} />
            </div>

            <!-- Card 4 -->
            <div class="about-card">
              <div class="about-card-icon">🛡️</div>
              <h3>Tecnologia Sem Quebrar Piso</h3>
              <p set:html={card4Text} />
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 3: PONTOS CONHECIDOS & REFERÊNCIAS (FUNDO BRANCO) -->
      <section class="section-block bg-white">
        <div class="container container-medium">
