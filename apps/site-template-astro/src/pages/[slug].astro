---
import Layout from '../layouts/Layout.astro';
import cityData from '../data/cityConfig.json';
import { slugify } from '../utils/slugify';
import '../styles/themePalettes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import FAQ from '../components/FAQ.astro';
import Benefits from '../components/Benefits.astro';

export async function getStaticPaths() {
  const cidadeSlug = slugify(cityData.cidade);
  
  // Create a route for every service
  const servicePaths = cityData.services.map((service) => {
    const slug = `${slugify(service.title)}-em-${cidadeSlug}`;
    return {
      params: { slug },
      props: {
        type: 'service',
        title: service.title,
        description: service.description,
        icon: service.icon
      }
    };
  });

  // Create a route for every neighborhood
  const neighborhoodPaths = cityData.bairros.map((bairro) => {
    const slug = slugify(bairro);
    return {
      params: { slug },
      props: {
        type: 'neighborhood',
        name: bairro
      }
    };
  });

  return [...servicePaths, ...neighborhoodPaths];
}

const { slug } = Astro.params;
const props = Astro.props;

// Prepare custom SEO based on page type
let pageSeo = { ...cityData.seo };
let pageFaqs = [];

if (props.type === 'service') {
  const serviceName = props.title;
  pageSeo.metaTitle = `Desentupidora de ${serviceName} em ${cityData.cidade} ${cityData.uf} | Atendimento 24h`;
  pageSeo.metaDescription = `Especialistas em ${serviceName.toLowerCase()} em ${cityData.cidade} ${cityData.uf}. Chegamos em 30 min, orçamento gratuito e atendimento sem quebrar piso. Plantão 24h!`;
  pageSeo.h1Title = `Desentupidora de ${serviceName} em ${cityData.cidade} ${cityData.uf}`;
  pageSeo.firstParagraph = `Problemas com entupimento? Nossa equipe é especializada em desentupidora de ${serviceName.toLowerCase()} em ${cityData.cidade} ${cityData.uf}. Oferecemos atendimento emergencial rápido, serviço 100% limpo sem quebrar azulejos, com garantia por escrito e orçamento gratuito na sua residência ou empresa.`;
  pageSeo.lastH2 = `Por que somos a melhor opção para ${serviceName.toLowerCase()} em ${cityData.cidade}?`;
  
  pageFaqs = [
    { question: `Vocês atendem emergência para ${serviceName.toLowerCase()} em ${cityData.cidade}?`, answer: `Sim! Nosso plantão é 24 horas. Chegamos na sua residência ou empresa em até 30 minutos em qualquer bairro de ${cityData.cidade}.` },
    { question: `Precisa quebrar a parede para resolver o problema de ${serviceName.toLowerCase()}?`, answer: "Na grande maioria das vezes não. Utilizamos equipamentos modernos rotativos e de hidrojateamento que desobstruem o encanamento por dentro, sem necessidade de quebra-quebra." },
    { question: `A visita técnica para ${serviceName.toLowerCase()} é cobrada?`, answer: `Não cobramos taxa de visita em ${cityData.cidade}. Nossos técnicos vão até o local, avaliam a situação e passam um orçamento transparente sem compromisso.` },
    { question: `Qual é a garantia do serviço de ${serviceName.toLowerCase()}?`, answer: `Oferecemos garantia por escrito de até 90 dias para todos os nossos serviços de desentupimento, garantindo sua total tranquilidade.` },
    { question: `Vocês atendem empresas e comércios para ${serviceName.toLowerCase()}?`, answer: `Sim, possuímos equipes especializadas tanto para atendimento residencial quanto para condomínios, restaurantes, indústrias e comércios em geral.` },
    { question: `Quais equipamentos são usados no ${serviceName.toLowerCase()}?`, answer: `Utilizamos maquinário de ponta, como molas rotativas K-50 e K-500, além de caminhões de hidrojateamento de alta pressão, dependendo da gravidade da obstrução.` }
  ];
} else if (props.type === 'neighborhood') {
  const bairroName = props.name;
  pageSeo.metaTitle = `Desentupidora no bairro ${bairroName}, ${cityData.cidade} ${cityData.uf} | Atendimento 24h`;
  pageSeo.metaDescription = `Precisando de desentupidora no bairro ${bairroName} em ${cityData.cidade} ${cityData.uf}? Atendimento emergencial 24h para esgoto, pias e ralos. Visita grátis e menor preço!`;
  pageSeo.h1Title = `Desentupidora no ${bairroName}, ${cityData.cidade}: Atendimento Rápido no Seu Bairro`;
  pageSeo.firstParagraph = `Precisando de uma desentupidora no ${bairroName}, ${cityData.cidade}? A ${cityData.empresaNome} atende o bairro com técnicos que conhecem a região, visita técnica gratuita e orçamento fechado antes de começar qualquer serviço.`;
  pageSeo.lastH2 = `Por que escolher a ${cityData.empresaNome} no bairro ${bairroName}?`;
  
  // Reuse home FAQs but contextualize them to the neighborhood
  pageFaqs = (cityData.faqs || []).map(f => {
    return {
      question: f.question.replace(cityData.cidade, `${bairroName} - ${cityData.cidade}`),
      answer: f.answer.replace(cityData.cidade, `${bairroName} - ${cityData.cidade}`)
    };
  });
  while(pageFaqs.length < 6) {
    pageFaqs.push({
      question: `Como solicitar visita técnica no bairro ${bairroName}?`,
      answer: `Basta nos chamar no WhatsApp ou ligar. Uma equipe mais próxima ao bairro ${bairroName} será despachada imediatamente.`
    });
  }
}
---

<Layout {...cityData} seo={pageSeo} faqs={pageFaqs}>
  <Header {...cityData} />
  
  {props.type === 'neighborhood' ? (
    <!-- ========================================================================= -->
    <!-- MODELO MODERNO EM SEÇÕES CLARAS & CARDS (PADRÃO CRISTO REI / RONDONÓPOLIS) -->
    <!-- ========================================================================= -->
    <main class="bairro-page-wrapper">
      
      <!-- HERO DO BAIRRO (AZUL ESCURO PREMIUM) -->
      <section class="bairro-hero-sec">
        <div class="container text-center">
          <nav class="bairro-breadcrumbs">
            <a href="/">Início</a> <span>›</span> <a href="/#bairros">Bairros</a> <span>›</span> <span>{props.name}</span>
          </nav>
          
          <div class="badge-pill">
            <span>📍 Atendimento no Bairro {props.name}</span>
          </div>
          
          <h1 class="hero-title">
            Desentupidora no {props.name}, {cityData.cidade}: <br/>
            <span class="hero-highlight">Atendimento Rápido no Seu Bairro</span>
          </h1>
          
          <p class="hero-description">
            Precisando de uma desentupidora no <strong>{props.name}</strong>, em <strong>{cityData.cidade}</strong>? A <strong>{cityData.empresaNome}</strong> atende o bairro com técnicos que conhecem a região, visita técnica gratuita e orçamento fechado antes de começar qualquer serviço.
          </p>

          <div class="hours-badge">
            🕒 Horário de Atendimento: Segunda a Domingo | Plantão Emergencial 24 Horas
          </div>

          <div class="hero-buttons-group">
            <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá,%20preciso%20de%20orçamento%20urgente%20no%20bairro%20${props.name}%20em%20${cityData.cidade}`} class="btn btn-wa-glow" target="_blank" rel="noopener">
              💬 Solicitar Orçamento Grátis no WhatsApp
            </a>
            <a href={`tel:${cityData.whatsapp}`} class="btn btn-phone-dark">
              📞 Ligar Agora: ({cityData.ddd}) {cityData.whatsapp.substring(2, 7)}-{cityData.whatsapp.substring(7)}
            </a>
          </div>

          <div class="hero-trust-bar">
            <div class="trust-pill"><span>✓</span> Orçamento Grátis</div>
            <div class="trust-pill"><span>✓</span> Garantia por Escrito*</div>
            <div class="trust-pill"><span>✓</span> Base no Próprio Bairro</div>
            <div class="trust-pill"><span>✓</span> Sem Quebrar Pisos</div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 1: RESPOSTA RÁPIDA (FUNDO BRANCO) -->
      <section class="section-block bg-white">
        <div class="container container-narrow">
          <div class="section-tag-center">
            <span class="tag-badge">RESPOSTA RÁPIDA</span>
          </div>
          <h2 class="section-heading text-center">Desentupidora no {props.name}: o que você precisa saber</h2>
          
          <div class="quick-answer-card">
            <div class="quick-answer-header">
              <span class="quick-icon">⚡</span>
              <h3>Atendimento Direto & Imediato no Bairro {props.name}</h3>
            </div>
            <p>
              A <strong>{cityData.empresaNome}</strong> mantém viaturas móveis e técnicos especializados posicionados estrategicamente na região do <strong>{props.name}</strong>, em {cityData.cidade} - {cityData.uf}. Atendemos residências, condomínios prediais e empresas com desentupimento de esgoto, pia de cozinha, vasos sanitários, ralos pluviais, caixas de gordura, esgotamento de fossas sépticas e hidrojateamento de alta pressão. Assim que você entra em contato, agendamos uma <strong>visita técnica 100% gratuita</strong> para avaliar a tubulação no local e fechar o orçamento antes de iniciar o trabalho.
            </p>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 2: CONHECENDO O BAIRRO (FUNDO CINZA SUAVE) COM 4 CARDS ESTRUTURADOS -->
      <section class="section-block bg-light">
        <div class="container container-medium">
          <div class="section-tag-center">
            <span class="tag-badge">CONHECENDO O BAIRRO</span>
          </div>
          <h2 class="section-heading text-center">O Bairro {props.name} em {cityData.cidade}</h2>
          <p class="section-lead text-center">
            Entenda como nossa estrutura operacional e conhecimento da região garantem o atendimento mais rápido e eficiente:
          </p>

          <div class="about-bairro-grid">
            <!-- Card 1 -->
            <div class="about-card">
              <div class="about-card-icon">🏙️</div>
              <h3>Perfil e Infraestrutura</h3>
              <p>
                O bairro <strong>{props.name}</strong> é uma localidade de destaque em {cityData.cidade}, reunindo áreas residenciais ativas, condomínios, comércio variado, padarias, escolas e restaurantes com grande fluxo diário de pessoas.
              </p>
            </div>

            <!-- Card 2 -->
            <div class="about-card">
              <div class="about-card-icon">🚀</div>
              <h3>Agilidade e Chegada em 30 Min</h3>
              <p>
                Nossas viaturas de suporte circulam diariamente pelas principais vias de acesso do <strong>{props.name}</strong>. Essa proximidade nos permite chegar em <strong>20 a 35 minutos</strong> para conter transbordamentos e entupimentos urgentes.
              </p>
            </div>

            <!-- Card 3 -->
            <div class="about-card">
              <div class="about-card-icon">⚠️</div>
              <h3>Desafios Hidráulicos Comuns</h3>
              <p>
                A mescla de imóveis tradicionais e novas construções no {props.name} gera demandas constantes de desobstrução por gordura acumulada, raízes em tubulações coletoras e sobrecarga em encanamentos prediais.
              </p>
            </div>

            <!-- Card 4 -->
            <div class="about-card">
              <div class="about-card-icon">🛡️</div>
              <h3>Tecnologia Sem Quebrar Piso</h3>
              <p>
                Trabalhamos com máquinas rotativas flexíveis K-50/K-500 e hidrojato de alta pressão, desobstruindo os canos por dentro e preservando seus pisos, azulejos e paredes intactos.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 3: PONTOS CONHECIDOS & REFERÊNCIAS (FUNDO BRANCO) -->
      <section class="section-block bg-white">
        <div class="container container-medium">
          <div class="section-tag-center">
            <span class="tag-badge">REFERÊNCIAS DO BAIRRO</span>
          </div>
          <h2 class="section-heading text-center">Pontos Conhecidos e Vias de Atendimento no {props.name}</h2>
          <p class="section-lead text-center">Nossos técnicos atendem com facilidade e conhecimento em todos os eixos do bairro:</p>

          <div class="landmarks-grid">
            <div class="landmark-box">
              <span class="landmark-ico">🛣️</span>
              <h4>Principais Avenidas e Ruas</h4>
              <p>Cobertura nas vias de tráfego central e ruas residenciais do {props.name}.</p>
            </div>
            <div class="landmark-box">
              <span class="landmark-ico">🏢</span>
              <h4>Condomínios & Prédios</h4>
              <p>Atendimento prioritário para síndicos e manutenção preventiva de colunas prediais.</p>
            </div>
            <div class="landmark-box">
              <span class="landmark-ico">🏪</span>
              <h4>Comércio & Restaurantes</h4>
              <p>Desobstrução higiênica e rápida para cozinhas comerciais sem interromper suas vendas.</p>
            </div>
            <div class="landmark-box">
              <span class="landmark-ico">🏡</span>
              <h4>Casas, Sobrados e Empresas</h4>
              <p>Equipes uniformizadas e educadas com foco total na limpeza e preservação do imóvel.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 4: MAPA DEDICADO DO BAIRRO (FUNDO CINZA) -->
      <section class="section-block bg-light">
        <div class="container container-medium">
          <div class="section-tag-center">
            <span class="tag-badge">ÁREA DE COBERTURA</span>
          </div>
          <h2 class="section-heading text-center">Localização e Mapa do Bairro {props.name} em {cityData.cidade}</h2>
          <p class="section-lead text-center">
            Confira no mapa a área atendida pelas nossas unidades móveis de plantão no bairro {props.name} ({cityData.cidade} - {cityData.uf}):
          </p>

          <div class="map-container-styled">
            <div class="map-header-bar">
              <span class="map-pin">📍</span>
              <div>
                <strong>Mapa Interativo do Bairro {props.name}</strong>
                <small>{props.name}, {cityData.cidade} - {cityData.uf}</small>
              </div>
            </div>
            <div class="map-iframe-box">
              <iframe 
                width="100%" 
                height="380" 
                frameborder="0" 
                scrolling="no" 
                marginheight="0" 
                marginwidth="0" 
                src={`https://maps.google.com/maps?q=${encodeURIComponent(props.name + ', ' + cityData.cidade + ' - ' + cityData.uf + ', Brasil')}&t=&z=14&ie=UTF8&iwloc=&output=embed`}
                style="border: none; display: block;"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 5: SERVIÇOS NO BAIRRO (FUNDO BRANCO) -->
      <section class="section-block bg-white">
        <div class="container container-medium">
          <div class="section-tag-center">
            <span class="tag-badge">SERVIÇOS NO BAIRRO</span>
          </div>
          <h2 class="section-heading text-center">Serviços de Desentupimento no {props.name}</h2>
          <p class="section-lead text-center">Plantão emergencial com frotas completas para atender qualquer tipo de encanamento:</p>

          <div class="services-cards-grid">
            {(cityData.services || []).map((s) => (
              <div class="service-item-card">
                <div class="service-card-top">
                  <span class="service-item-icon">{s.icon || '⚙️'}</span>
                  <h3>{s.title}</h3>
                </div>
                <p>{s.description}</p>
                <div class="service-card-bottom">
                  <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá,%20orçamento%20para%20${encodeURIComponent(s.title)}%20no%20bairro%20${props.name}%20em%20${cityData.cidade}`} class="service-action-link" target="_blank" rel="noopener">
                    Solicitar Orçamento no WhatsApp →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>
  ) : (
    <!-- ========================================================================= -->
    <!-- MODELO PARA PÁGINAS DE SERVIÇOS -->
    <!-- ========================================================================= -->
    <main class="service-page-wrapper">
      <section class="service-hero-sec">
        <div class="container service-hero-grid">
          <div>
            <div class="badge-pill">
              <span>🔧 SERVIÇO ESPECIALIZADO</span>
            </div>
            <h1 class="hero-title">{pageSeo.h1Title}</h1>
            <p class="hero-description">{pageSeo.firstParagraph}</p>
            <div class="hero-buttons-group">
              <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá,%20preciso%20de%20atendimento%20para%20${props.title}%20em%20${cityData.cidade}`} class="btn btn-wa-glow" target="_blank" rel="noopener">
                💬 Chamar no WhatsApp 24h
              </a>
            </div>
          </div>
          {cityData.heroImage && (
            <div class="service-hero-img-box">
              <img src={cityData.heroImage} alt={pageSeo.h1Title} />
            </div>
          )}
        </div>
      </section>

      <section class="section-block bg-white">
        <div class="container container-narrow">
          <div class="service-content-card">
            <span class="service-large-icon">{props.icon}</span>
            <h2>Como realizamos o {props.title} em {cityData.cidade}</h2>
            <p>{props.description} Nossa equipe técnica utiliza equipamentos de ponta para garantir a desobstrução completa sem danificar sua tubulação. O serviço é rápido, higiênico e possui garantia total.</p>
            
            <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá, preciso de um orçamento para ${props.title}`} class="btn btn-wa-glow" target="_blank" rel="noopener">
              Solicitar Orçamento Agora
            </a>
          </div>
        </div>
      </section>
    </main>
  )}

  <!-- FAQ SECTION CONTEXTUALIZADA -->
  <FAQ {...cityData} faqs={pageFaqs} cidade={props.type === 'neighborhood' ? `${props.name} - ${cityData.cidade}` : cityData.cidade} />

  <!-- STRICT SEO RULE: este precisa ser o ÚLTIMO H2 da página, logo antes do rodapé. -->
  <Benefits {...cityData} lastH2Text={pageSeo.lastH2} />

  <Footer {...cityData} />
  <FloatingWhatsapp {...cityData} />
</Layout>

<style is:global>
  /* ========================================================================= */
  /* RESET & CONTAINER UTILITIES */
  /* ========================================================================= */
  .bairro-page-wrapper, .service-page-wrapper {
    background-color: #ffffff;
    color: #1e293b;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .container-medium {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .container-narrow {
    max-width: 840px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .text-center {
    text-align: center;
  }

  /* SECTION BLOCKS */
  .section-block {
    padding: 70px 0;
  }
  .bg-white {
    background-color: #ffffff !important;
    color: #0f172a !important;
  }
  .bg-light {
    background-color: #f8fafc !important;
    color: #0f172a !important;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  /* SECTION HEADINGS & BADGES */
  .section-tag-center {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }
  .tag-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    color: #0284c7;
    background: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.2);
    padding: 5px 16px;
    border-radius: 30px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .section-heading {
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a !important;
    margin-bottom: 14px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .section-lead {
    font-size: 1.08rem;
    color: #64748b !important;
    max-width: 680px;
    margin: 0 auto 40px auto;
    line-height: 1.6;
  }

  /* ========================================================================= */
  /* 1. HERO SECTION */
  /* ========================================================================= */
  .bairro-hero-sec {
    background: linear-gradient(135deg, #090f1d 0%, #0d1a33 50%, #070d18 100%);
    color: #ffffff;
    padding: 60px 0 50px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bairro-breadcrumbs {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 18px;
  }
  .bairro-breadcrumbs a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .bairro-breadcrumbs a:hover {
    color: #38bdf8;
  }
  .bairro-breadcrumbs span {
    margin: 0 6px;
    color: #64748b;
  }
  .badge-pill {
    display: inline-block;
    background: rgba(2, 132, 199, 0.2);
    border: 1px solid #0284c7;
    color: #38bdf8;
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 22px;
  }
  .hero-title {
    font-size: 2.6rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    color: #ffffff !important;
  }
  .hero-highlight {
    color: #38bdf8;
  }
  .hero-description {
    font-size: 1.15rem;
    color: #cbd5e1 !important;
    max-width: 800px;
    margin: 0 auto 24px auto;
    line-height: 1.7;
  }
  .hours-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    padding: 8px 22px;
    border-radius: 20px;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 30px;
  }
  .hero-buttons-group {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: 10px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 1rem;
    cursor: pointer;
  }
  .btn-wa-glow {
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);
  }
  .btn-wa-glow:hover {
    background: #20ba59;
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(37, 211, 102, 0.6);
  }
  .btn-phone-dark {
    background: #1e293b;
    color: #ffffff;
    border: 1px solid #475569;
  }
  .btn-phone-dark:hover {
    background: #334155;
    transform: translateY(-2px);
  }
  .hero-trust-bar {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.92rem;
    color: #94a3b8;
    font-weight: 700;
