---
import Layout from '../layouts/Layout.astro';
import cityData from '../data/cityConfig.json';
import '../styles/themePalettes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import Benefits from '../components/Benefits.astro';

export async function getStaticPaths() {
  if (cityData.parceiros && cityData.parceiros.length > 0) {
    return [{
      params: { parceiros_route: 'rede-de-parceiros' }
    }];
  }
  return [];
}

const pageSeo = {
  metaTitle: `Nossa Rede de Parceiros | ${cityData.empresaNome || cityData.seo.metaTitle}`,
  metaDescription: `Consulte nossa rede de empresas parceiras especializadas em desentupimento que atendem regiões fora da área de atuação principal da ${cityData.empresaNome}.`
};

const palette = cityData.paletaCores || 'urgencia-azul-laranja';
const partners = cityData.parceiros || [];
---

<Layout seo={pageSeo} palette={palette} companyData={{ phone: cityData.whatsapp, address: cityData.endereco }}>
  <Header {...cityData} />

  <main>
    <!-- HERO SECTION -->
    <section class="hero-partners">
      <div class="container">
        <div class="breadcrumbs">
          <a href="/">Início</a> <span>›</span> <strong>Rede de Parceiros</strong>
        </div>
        
        <div class="hero-content">
          <div class="tag">🤝 Parceiros de Confiança</div>
          <h1>Nossa Rede de Parceiros</h1>
          <p>
            Nem sempre conseguimos atender diretamente todas as regiões com a agilidade que você merece. 
            Por isso, contamos com empresas parceiras de altíssima qualidade especializadas em desentupimento 
            em diversas outras cidades e estados.
          </p>
          <p class="subtitle">
            Se você está fora da nossa área principal de atendimento em <strong>{cityData.cidade} - {cityData.uf}</strong>, 
            consulte abaixo nossos parceiros certificados.
          </p>
        </div>
      </div>
    </section>

    <!-- PARTNERS GRID -->
    <section class="partners-grid-section">
      <div class="container">
        <div class="partners-grid">
          {partners.map(p => (
            <div class="partner-card">
              <div class="partner-card-header">
                <span class="partner-type">{p.tipo || 'Empresa Parceira'}</span>
                {p.status === 'ativo' && <span class="partner-status">Ativo</span>}
              </div>
              <h3 class="partner-name">{p.nome}</h3>
              <div class="partner-location">📍 {p.cidade} - {p.uf}</div>
              <p class="partner-desc">{p.descricao}</p>
              
              <div class="partner-actions">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn-partner">
                  Conhecer Parceiro
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Benefits />

    <!-- CTA FOOTER -->
    <section class="cta-bottom">
      <div class="container cta-container">
        <div class="cta-text">
          <h2>Não encontrou sua região?</h2>
          <p>Fale conosco no WhatsApp! Podemos recomendar a melhor equipe para lhe atender, mesmo que não esteja listada acima.</p>
        </div>
        <a href={`https://wa.me/55${cityData.whatsapp}?text=Olá! Vocês teriam indicação de desentupidora para a minha região?`} target="_blank" class="cta-btn">
          Chamar no WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer {...cityData} />
  <FloatingWhatsapp phone={cityData.whatsapp} />
</Layout>

<style is:global>
  /* HERO PARTNERS */
  .hero-partners {
    background-color: var(--color-bg-alt);
    padding: 100px 0 60px;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-partners .container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 24px;
  }
  
  .breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .hero-partners .tag {
    display: inline-block;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.85rem;
    margin-bottom: 16px;
  }

  .hero-partners h1 {
    font-size: 2.8rem;
    color: var(--color-text-dark);
    margin-bottom: 20px;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .hero-partners p {
    font-size: 1.15rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .hero-partners p.subtitle {
    font-size: 1rem;
    background-color: var(--color-bg-body);
    padding: 16px 24px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    display: inline-block;
    margin-top: 10px;
  }

  /* GRID DE PARCEIROS */
  .partners-grid-section {
    padding: 80px 0;
    background-color: var(--color-bg-body);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .partner-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .partner-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    border-color: var(--color-primary);
  }

  .partner-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--color-primary);
    opacity: 0;
    transition: 0.3s;
  }

  .partner-card:hover::before {
    opacity: 1;
  }

  .partner-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .partner-type {
    background-color: var(--color-bg-alt);
    color: var(--color-text-light);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .partner-status {
    background-color: #dcfce7;
    color: #166534;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .partner-name {
    font-size: 1.4rem;
    color: var(--color-text-dark);
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .partner-location {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.95rem;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .partner-desc {
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .partner-actions {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .btn-partner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background-color: var(--color-bg-body);
    color: var(--color-text-dark);
    border: 1px solid var(--color-border);
    padding: 14px 20px;
    border-radius: 12px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-partner:hover {
    background-color: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  /* CTA BOTTOM */
  .cta-bottom {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    padding: 80px 20px;
    text-align: center;
  }

  .cta-container {
    max-width: 700px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .cta-bottom h2 {
    color: #fff;
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .cta-bottom p {
    color: rgba(255,255,255,0.9);
    font-size: 1.1rem;
    margin-bottom: 30px;
    line-height: 1.5;
  }

  .cta-btn {
    display: inline-block;
    background-color: #fff;
    color: var(--color-primary);
    padding: 16px 32px;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
    transition: 0.3s;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.15);
  }

  @media (max-width: 768px) {
    .hero-partners { padding: 60px 0 40px; }
    .hero-partners h1 { font-size: 2.2rem; }
    .partners-grid { grid-template-columns: 1fr; }
  }
</style>
